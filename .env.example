# Copy this file to .env and fill in what you need. The .env file is never committed.
# In CI and in the hosted app these values come from GitHub Secrets / the host's settings.
# Synthetic data, fictional company.

# --- Which environment ------------------------------------------------------------
# dev  = local DuckDB + SQLite, offline (default)
# prod = Databricks + Postgres
DSO_ENV=dev

# true (default) = replay cached LLM responses and never call the API.
# Set to false only when you want to make real API calls and have a key below.
DSO_OFFLINE_MODE=true

# true = a rule-based stand-in plays the model (labelled as such everywhere). For machines
# with no key and no network. The default is false: cached real responses are replayed.
DSO_LLM_STAND_IN=false

# --- The only paid service: the LLM API -------------------------------------------
# Needed only when DSO_OFFLINE_MODE=false.
ANTHROPIC_API_KEY=
# A run stops cleanly when either limit is reached, and logs what it spent.
MAX_LLM_CALLS_PER_RUN=400
LLM_BUDGET_USD=5.00
MAX_AGENT_CONVERSATIONS_PER_RUN=50

# --- Tracing (optional, free tier) ------------------------------------------------
# With a key, agent runs are also traced to LangSmith (names and emails masked).
# Without one, traces are written as JSON files in traces/.
LANGSMITH_API_KEY=

# --- prod only: Databricks Free Edition -------------------------------------------
# Workspace URL host (no https://) and the SQL warehouse HTTP path. Leave the token empty
# to sign in through the browser (OAuth); set it only where no browser exists (CI).
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
# Optional: an existing catalog to use instead of creating `relay` (Free Edition: workspace).
DATABRICKS_CATALOG=

# --- prod only: Postgres operational store (Neon or Supabase free tier) ------------
# Example: postgresql+psycopg://user:password@host/dbname
DATABASE_URL=

# --- Human console logins (demo accounts) ------------------------------------------
# Passwords for the three demo roles. Any value works locally; set real ones when hosted.
CONSOLE_PASSWORD_CSM=
CONSOLE_PASSWORD_SALES=
CONSOLE_PASSWORD_ADMIN=
